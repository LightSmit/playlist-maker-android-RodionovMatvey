<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Синий хедер -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="#3772E7"
        android:gravity="clip_vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="158dp"
            android:layout_height="wrap_content"
            android:text="Playlist maker"
            android:textColor="@android:color/white"
            android:textSize="22dp"
            android:fontFamily="@font/yandex_sans_display_bold"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Белая "карточка" со скруглением, наезжающая на синий бар -->
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="667dp"
        android:layout_marginTop="-24dp"
        android:layout_weight="1"
        android:background="@drawable/bg_main_card"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <!-- Поиск -->
        <LinearLayout
            android:id="@+id/btn_search"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="Поиск"
                android:textColor="#1A1B22"
                android:textSize="22sp"
                android:fontFamily="@font/yandex_sans_display_bold"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#B0B0B0" />
        </LinearLayout>

        <!-- Плейлисты -->
        <LinearLayout
            android:id="@+id/btn_playlists"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_playlists" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="Плейлисты"
                android:textColor="#1A1B22"
                android:textSize="22sp"
                android:fontFamily="@font/yandex_sans_display_bold"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#B0B0B0" />
        </LinearLayout>

        <!-- Избранное -->
        <LinearLayout
            android:id="@+id/btn_favorites"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_favorites" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="Избранное"
                android:textColor="#1A1B22"
                android:textSize="22sp"
                android:fontFamily="@font/yandex_sans_display_bold"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#B0B0B0" />
        </LinearLayout>

        <!-- Настройки -->
        <LinearLayout
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="Настройки"
                android:textColor="#1A1B22"
                android:textSize="22sp"
                android:fontFamily="@font/yandex_sans_display_bold"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#B0B0B0" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>